# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/bookmarked

# Signs the session cookie. At least 32 characters. Create one with: openssl rand -base64 48
JWT_SECRET=

# Optional. Without a key, AI search answers 503 and the rest of the app works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
